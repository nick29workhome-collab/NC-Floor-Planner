<!doctype html><html lang="ro"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><meta name="apple-mobile-web-app-capable" content="yes"><title>NC Floor Planner v5 · CAD + Orbit 3D</title><style>
*{box-sizing:border-box}body{margin:0;font:14px system-ui,-apple-system,sans-serif;color:#19283c;background:#edf2f7}header{background:#16243b;color:#fff;padding:9px 12px;display:flex;gap:8px;align-items:center;justify-content:space-between}h1{font-size:16px;margin:0}button,input,select,textarea{font:inherit}button{border:1px solid #c5d0dd;background:white;color:#172942;border-radius:8px;padding:9px;cursor:pointer;min-height:39px}button.active{background:#2563eb;color:white;border-color:#2563eb}button:disabled{opacity:.4}.tools{display:flex;flex-wrap:wrap;gap:5px;padding:7px;background:#fff;border-bottom:1px solid #d2dae5}.tools button{font-size:13px;padding:8px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 286px;height:calc(100dvh - 106px)}main{position:relative;background:white;min-height:300px;overflow:hidden}svg{display:block;width:100%;height:100%;touch-action:none}aside{padding:12px;overflow:auto;background:#f8fafc;border-left:1px solid #d6deea}aside h2{font-size:15px;margin:8px 0}label{display:block;font-size:12px;color:#53647a;margin:7px 0 3px}input,select,textarea{width:100%;border:1px solid #bdcad9;padding:8px;border-radius:7px;background:white;color:#16243b;min-height:36px}textarea{min-height:60px}.fieldrow{display:grid;grid-template-columns:1fr 1fr;gap:7px}.actions{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0}.actions button{flex:1;font-size:12px}#status{position:absolute;left:8px;bottom:8px;background:#fffe;padding:8px;border:1px solid #d7e2eb;border-radius:8px;font-size:12px;max-width:90%;pointer-events:none}#file{display:none}.hint{font-size:11px;color:#596a80;line-height:1.45}.pill{font-size:11px;background:#dbeafe;border-radius:10px;padding:4px 6px}hr{border:0;border-top:1px solid #dce4ef;margin:12px 0}@media(max-width:850px){.layout{grid-template-columns:1fr;grid-template-rows:minmax(350px,58dvh) auto;height:auto}aside{border-left:0;border-top:1px solid #d6deea;max-height:none}main{min-height:350px}.tools button{min-height:43px}}@media print{header,.tools,aside,#status{display:none!important}.layout{display:block;height:auto}main{height:100vh}body{background:white}} </style></head><body>
<header><h1>NC Floor Planner <span class="pill">v5 · CAD + Orbit 3D · offline</span></h1><span id="projectName">Proiect nou</span><button id="projects">Proiecte</button></header>
<div class="tools"><button id="view2d" class="active">▦ Plan 2D</button><button id="view3d">▧ Vedere 3D</button><button data-tool="wall" class="active">▱ Pereți</button><button data-tool="select">↖ Selectează</button><button data-tool="door">🚪 Ușă</button><button data-tool="window">▤ Fereastră</button><button data-tool="opening">▯ Gol</button><button data-tool="sliding">⇆ Glisantă</button><button data-tool="column">▣ Stâlp</button><button data-tool="furniture">▥ Mobilier</button><button data-tool="measure">↔ Măsoară</button><button data-tool="pan">✥ Deplasare</button><button id="undo">↶ Undo</button><button id="redo">↷ Redo</button><button id="zoomIn">＋</button><button id="zoomOut">－</button><button id="fit">Încadrare</button><button id="toggleDims" class="active">Cote ±</button><button id="exportSvg">SVG</button></div>
<div class="layout"><main><svg id="threeview" xmlns="http://www.w3.org/2000/svg" style="display:none;background:#e9f2fa;cursor:grab" aria-label="Vizualizare tridimensională a proiectului"></svg><svg id="plan" xmlns="http://www.w3.org/2000/svg" aria-label="Editor plan"></svg><div id="status">Click pentru primul punct; apoi click pentru capătul peretelui.</div></main><aside>
<h2>Proiect</h2><label>Nume proiect</label><input id="name" value="Proiect nou"><div class="fieldrow"><div><label>Client</label><input id="client" placeholder="Client"></div><div><label>Încăpere</label><input id="room" placeholder="Bucătărie"></div></div><label>Adresă</label><input id="address" placeholder="Adresă"><div class="fieldrow"><div><label>Unitate afișare</label><select id="units"><option value="mm">mm</option><option value="cm">cm</option><option value="m">m</option></select></div><div><label>Unghi perete</label><select id="angle"><option value="free">Liber</option><option value="90">0° / 90°</option><option value="45" selected>Din 45° în 45°</option></select></div></div>
<hr><h2>Parametri desen</h2><p class="hint">Cotele ± afișează distanțele paralele la fețele interioare/exterioare ale fiecărui perete; nu înlocuiesc un releveu cu intersecții calculate.</p><div class="fieldrow"><div><label>Lungime exactă (mm)</label><input type="number" id="length" min="1" placeholder="4000"></div><div><label>Direcție exactă (°)</label><input type="number" id="direction" value="0" step="1"></div></div><div class="fieldrow"><div><label>Grosime perete (mm)</label><select id="thick"><option>100</option><option selected>150</option><option>250</option><option value="other">Personalizat…</option></select><input id="customThick" type="number" value="200" min="20" style="display:none"></div><div><label>Pas grilă (mm)</label><select id="grid"><option>10</option><option selected>50</option><option>100</option></select></div></div><div class="actions"><button id="exact">Adaugă lungime exactă</button><button id="finish">Terminare lanț</button></div>
<hr><h2>Vedere 3D</h2><div class="fieldrow"><div><label>Înălțime pereți (mm)</label><input id="wallHeight3d" type="number" min="100" max="10000" step="100" value="2700"></div><div><label>Unghi cameră</label><input id="cameraAngle3d" type="range" min="0" max="359" value="42"></div></div><div class="actions"><button id="turnLeft3d">↶ Rotește</button><button id="turnRight3d">↷ Rotește</button><button id="reset3d">Încadrare 3D</button><button id="top3d">Vedere de sus</button><button id="front3d">Din față</button><button id="iso3d">Izometric</button></div><p class="hint">Apasă „Vedere 3D”. Trage pentru orbită pe orizontală și verticală; Shift + tragere sau butonul drept = deplasare; rotița mouse-ului = zoom. Pe iPad: un deget = orbită; două degete = zoom și deplasare. Modificările se fac în 2D și apar imediat în 3D. Vizualizare orientativă, nu model BIM sau fișier pentru execuție. Orbit tactil trebuie testat pe dispozitiv.</p><hr><h2>Obiecte</h2><div class="fieldrow"><div><label>Lățime gol / mobilier (mm)</label><input id="width" type="number" value="900" min="50"></div><div><label>Adâncime mobilier (mm)</label><input id="depth" type="number" value="560" min="50"></div></div><div class="fieldrow"><div><label>Înălțime (mm)</label><input id="height" type="number" value="720" min="50"></div><div><label>Parapet fereastră (mm)</label><input id="sill" type="number" value="900" min="0"></div></div><div class="fieldrow"><div><label>Poziție de la început perete (mm)</label><input id="position" type="number" min="0" placeholder="650"></div><div><label>Deschidere ușă</label><select id="swing"><option value="left">Stânga</option><option value="right">Dreapta</option></select></div></div><label>Tip mobilier</label><select id="furnType"><option value="Dulap">Dulap</option><option value="Corp bucătărie">Corp bucătărie</option><option value="Colț">Corp colț (amprentă rectangulară)</option><option value="Insulă">Insulă</option><option value="Electrocasnic">Electrocasnic</option></select><div class="actions"><button id="update">Aplică pe selectat</button><button id="duplicate">Duplică</button><button id="delete">Șterge</button></div><p class="hint" id="selection">Niciun obiect selectat. Trage un obiect cu instrumentul Selectează. Pentru goluri, poziția este măsurată de la capătul A până la marginea golului.</p>
<hr><h2>Măsurători / note</h2><div id="stats" class="hint">Suprafață: —</div><label>Note de montaj</label><textarea id="notes" placeholder="Măsurători, observații…"></textarea><div class="actions"><button id="measurements">Listă TXT</button><button id="png">PNG</button><button id="dxf">DXF</button><button id="pdf">PDF / Tipărire</button></div><label>Scară PDF</label><select id="printScale"><option value="20">1:20</option><option value="50" selected>1:50</option><option value="100">1:100</option></select><p class="hint">PDF se salvează prin dialogul de tipărire al browserului. Pentru scară fizică exactă, dezactivează „Fit to page”, setează 100% și verifică o cotă imprimată.</p>
<hr><h2>Salvare</h2><div class="actions"><button id="save">Export JSON</button><button id="load">Import JSON</button><button id="new">Proiect nou</button></div><input id="file" type="file" accept=".json,application/json"><p class="hint" id="autosave">Salvare locală automată dacă browserul permite stocarea pentru fișiere locale. Pe iPad exportă JSON după fiecare sesiune: Safari poate șterge datele locale.</p><p class="hint">Gesturi: mouse wheel = zoom; două degete = zoom și deplasare; un deget/Apple Pencil = desen; Esc = terminare; Delete = ștergere; Ctrl+Z/Y = undo/redo. Fără internet sau biblioteci externe.</p>
</aside></div><script>
(()=>{'use strict';const $=id=>document.getElementById(id),svg=$('plan');let showFaceDimensions=true,items=[],undo=[],redo=[],selected=null,tool='wall',start=null,preview=null,scale=.12,pan={x:420,y:250},pointers=new Map(),drag=null,measureStart=null,measurement=null,projectId='default',storageOK=true;const clone=o=>JSON.parse(JSON.stringify(o));const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y),snap=v=>Math.round(v/(+$('grid').value||50))*(+$('grid').value||50),point=e=>{let r=svg.getBoundingClientRect();return{x:(e.clientX-r.left-pan.x)/scale,y:(e.clientY-r.top-pan.y)/scale}},uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const num=(id,fallback=0)=>Number.isFinite(+$ (id).value)?+$ (id).value:fallback;function saveLocal(){try{localStorage.setItem('nc_floor_'+projectId,JSON.stringify(snapshot()));$('autosave').textContent='Salvat local · '+new Date().toLocaleTimeString('ro-RO')}catch(e){storageOK=false;$('autosave').textContent='Stocarea locală indisponibilă: exportă JSON periodic.'}}function snapshot(){return{version:2,items:clone(items),meta:{name:$('name').value,client:$('client').value,room:$('room').value,address:$('address').value,notes:$('notes').value}}}function checkpoint(){undo.push(snapshot());if(undo.length>100)undo.shift();redo=[]}function restore(s){items=clone(s.items||[]);for(let k of ['name','client','room','address','notes'])$(k).value=s.meta?.[k]||'';selected=null;start=null;preview=null;render()}function changed(){saveLocal();render()}function unit(n){let u=$('units').value,k=u==='mm'?1:u==='cm'?10:1000;return (n/k).toLocaleString('ro-RO',{maximumFractionDigits:u==='m'?3:u==='cm'?1:0})+' '+u}function thickness(){return $('thick').value==='other'?Math.max(20,num('customThick',200)):num('thick',150)}function closest(p,a,b){let dx=b.x-a.x,dy=b.y-a.y,t=Math.max(0,Math.min(1,((p.x-a.x)*dx+(p.y-a.y)*dy)/(dx*dx+dy*dy||1)));return{t,x:a.x+t*dx,y:a.y+t*dy,d:Math.hypot(p.x-a.x-t*dx,p.y-a.y-t*dy)}}function constrain(p,a){let dx=p.x-a.x,dy=p.y-a.y,l=Math.hypot(dx,dy);if(!l)return a;let mode=$('angle').value,theta=Math.atan2(dy,dx);if(mode!=='free')theta=Math.round(theta/(Math.PI/(mode==='90'?2:4)))*(Math.PI/(mode==='90'?2:4));return{x:a.x+Math.cos(theta)*snap(l),y:a.y+Math.sin(theta)*snap(l)}}function anchor(p){let found=null,best=160;for(let o of items)if(o.kind==='wall')for(let v of [o.a,o.b]){let d=dist(p,v);if(d<best){best=d;found=v}}return found?{...found}:{x:snap(p.x),y:snap(p.y)}}function wallById(id){return items.find(x=>x.id===id&&x.kind==='wall')}function wallHit(p){let hit=null,best=Infinity;for(let w of items){if(w.kind!=='wall')continue;let v=closest(p,w.a,w.b);if(v.d<best){hit={w,...v};best=v.d}}return hit&&best<Math.max(240,18/scale)?hit:null}function shapeCenter(o){if(o.kind==='wall')return{x:(o.a.x+o.b.x)/2,y:(o.a.y+o.b.y)/2};if(o.kind==='opening'){let w=wallById(o.wall);if(!w)return{x:0,y:0};let l=dist(w.a,w.b)||1,t=(o.pos+o.width/2)/l;return{x:w.a.x+(w.b.x-w.a.x)*t,y:w.a.y+(w.b.y-w.a.y)*t}}return{x:o.x+o.width/2,y:o.y+o.depth/2}}function hit(p){let op=items.filter(o=>o.kind==='opening').reverse().find(o=>dist(p,shapeCenter(o))<Math.max(180,20/scale));if(op)return op;let furn=items.filter(o=>o.kind==='furniture'||o.kind==='column').reverse().find(o=>p.x>=o.x-80&&p.x<=o.x+o.width+80&&p.y>=o.y-80&&p.y<=o.y+o.depth+80);if(furn)return furn;return wallHit(p)?.w||null}function dim(x,y,t,cls=''){return `<text x="${x}" y="${y}" text-anchor="middle" fill="${cls||'#415a77'}" font-size="90" paint-order="stroke" stroke="#fff" stroke-width="15">${esc(t)}</text>`}function drawElements(){let s='';for(let o of items){let sel=selected===o.id;if(o.kind==='wall'){let d=dist(o.a,o.b)||1,nx=-(o.b.y-o.a.y)/d,ny=(o.b.x-o.a.x)/d,c={x:(o.a.x+o.b.x)/2,y:(o.a.y+o.b.y)/2};s+=`<line x1="${o.a.x}" y1="${o.a.y}" x2="${o.b.x}" y2="${o.b.y}" stroke="${sel?'#ed8737':'#344966'}" stroke-width="${o.thick}" stroke-linecap="butt"/>`;s+=dim(c.x+nx*(o.thick/2+115),c.y+ny*(o.thick/2+115),unit(d));if(showFaceDimensions){for(let sign of [-1,1]){let off=sign*(o.thick/2+270),aa={x:o.a.x+nx*off,y:o.a.y+ny*off},bb={x:o.b.x+nx*off,y:o.b.y+ny*off};s+=`<path d="M ${aa.x} ${aa.y} L ${bb.x} ${bb.y} M ${aa.x-nx*65} ${aa.y-ny*65} L ${aa.x+nx*65} ${aa.y+ny*65} M ${bb.x-nx*65} ${bb.y-ny*65} L ${bb.x+nx*65} ${bb.y+ny*65}" fill="none" stroke="#94a3b8" stroke-width="8"/>`;}}}else if(o.kind==='opening'){let w=wallById(o.wall);if(!w)continue;let l=dist(w.a,w.b)||1,ux=(w.b.x-w.a.x)/l,uy=(w.b.y-w.a.y)/l,nx=-uy,ny=ux,a={x:w.a.x+ux*o.pos,y:w.a.y+uy*o.pos},b={x:a.x+ux*o.width,y:a.y+uy*o.width},cx=(a.x+b.x)/2,cy=(a.y+b.y)/2,color=sel?'#f97316':o.type==='window'?'#0284c7':'#15803d';s+=`<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="white" stroke-width="${w.thick+22}"/><line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${color}" stroke-width="${o.type==='window'?36:13}"/>`;if(o.type==='door'){let direction=o.swing==='right'?-1:1,ex=a.x+nx*o.width*direction,ey=a.y+ny*o.width*direction;s+=`<line x1="${a.x}" y1="${a.y}" x2="${ex}" y2="${ey}" stroke="${color}" stroke-width="8"/><path d="M ${b.x} ${b.y} Q ${b.x+nx*o.width*.45*direction} ${b.y+ny*o.width*.45*direction} ${ex} ${ey}" fill="none" stroke="${color}" stroke-width="7" stroke-dasharray="28 25"/>`}else if(o.type==='sliding'){s+=`<line x1="${a.x+nx*50}" y1="${a.y+ny*50}" x2="${b.x+nx*50}" y2="${b.y+ny*50}" stroke="${color}" stroke-width="12"/>`}s+=dim(cx+nx*170,cy+ny*170,`${o.type==='window'?'F':o.type==='door'?'U':o.type==='sliding'?'UG':'G'} ${unit(o.width)}`); }else{let color=sel?'#f59e0b':o.kind==='column'?'#64748b':'#94a3b8';s+=`<rect x="${o.x}" y="${o.y}" width="${o.width}" height="${o.depth}" fill="${color}" fill-opacity=".35" stroke="${color}" stroke-width="18"/><text x="${o.x+o.width/2}" y="${o.y+o.depth/2}" text-anchor="middle" fill="#1e293b" font-size="82">${esc(o.type||'Stâlp')}</text>`;}}return s}function render(){let w=svg.clientWidth,h=svg.clientHeight,g=+ $('grid').value||50,gridSize=Math.max(g,Math.ceil(24/(g*scale))*g),s=`<defs><pattern id="grid" width="${gridSize*scale}" height="${gridSize*scale}" x="${pan.x}" y="${pan.y}" patternUnits="userSpaceOnUse"><path d="M ${gridSize*scale} 0 L 0 0 0 ${gridSize*scale}" fill="none" stroke="#e8edf4" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(#grid)"/>`;s+=`<g transform="translate(${pan.x} ${pan.y}) scale(${scale})">`+drawElements();if(preview)s+=`<line x1="${preview.a.x}" y1="${preview.a.y}" x2="${preview.b.x}" y2="${preview.b.y}" stroke="#2563eb" stroke-width="${thickness()}" opacity=".4"/>`+dim((preview.a.x+preview.b.x)/2,(preview.a.y+preview.b.y)/2-170,unit(dist(preview.a,preview.b)));if(start)s+=`<circle cx="${start.x}" cy="${start.y}" r="55" fill="#2563eb"/>`;if(measurement)s+=`<line x1="${measurement.a.x}" y1="${measurement.a.y}" x2="${measurement.b.x}" y2="${measurement.b.y}" stroke="#e11d48" stroke-width="18"/>`+dim((measurement.a.x+measurement.b.x)/2,(measurement.a.y+measurement.b.y)/2-100,unit(dist(measurement.a,measurement.b)));svg.innerHTML=s+'</g>';$('projectName').textContent=$('name').value||'Proiect nou';let o=items.find(x=>x.id===selected);$('selection').textContent=o?`Selectat: ${o.kind==='wall'?'Perete '+unit(dist(o.a,o.b)):o.kind==='opening'?o.type+' '+unit(o.width):(o.type||o.kind)+' '+unit(o.width)+' × '+unit(o.depth)}. Parametrii pot fi modificați din panou.`:'Niciun obiect selectat. Click pe obiect, apoi editează parametrii; poți trage obiectele.';let walls=items.filter(x=>x.kind==='wall'),sum=walls.reduce((v,x)=>v+dist(x.a,x.b),0),poly=[];if(walls.length>=3){poly=[walls[0].a,walls[0].b];for(let i=1;i<walls.length;i++){let last=poly.at(-1),q=walls[i];if(dist(last,q.a)<5)poly.push(q.b);else if(dist(last,q.b)<5)poly.push(q.a);else{poly=[];break}}}let area=poly.length>=4&&dist(poly[0],poly.at(-1))<5?Math.abs(poly.slice(0,-1).reduce((v,p,i,ar)=>v+p.x*ar[(i+1)%ar.length].y-ar[(i+1)%